# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/writely?schema=public"

# Auth Secret for JWT signing
AUTH_SECRET="writely-super-secret-jwt-signing-key-2026-production-ready"

# Optional External AI API Key (Gemini / OpenAI). If left blank, intelligent built-in provider will be used.
AI_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Storage Configuration
STORAGE_PROVIDER="local"
