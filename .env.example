# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/writely?schema=public"

# Auth Secret for JWT signing
AUTH_SECRET="writely-super-secret-jwt-signing-key-2026-production-ready"

# Optional External AI API Keys. The app prefers the most specific provider keys and falls back to the local Writely AI engine when none are configured.
# Set either the provider-specific keys below or a shared AI_API_KEY.
AI_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Application URL (override port in local dev if 3000 is already occupied, e.g. PORT=3001)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Storage Configuration
STORAGE_PROVIDER="local"
